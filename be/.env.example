# ─────────────────────────────────────────────────────────────────────────────
# CleanZ Backend — mẫu biến môi trường. Copy sang `.env` rồi điền giá trị thật.
#   cp .env.example .env
# KHÔNG commit `.env` (đã gitignore). File này chỉ chứa placeholder, không có secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=cz
# Tự áp migration khi boot (mặc định true). Đặt false để tắt.
DB_MIGRATIONS_RUN=true

# ── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Application ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3020
COOKIE_DOMAIN=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFY_EMAIL_SECRET=change_me_verify_secret
JWT_VERIFY_EMAIL_EXPIRES_IN=5m
JWT_RESET_PASSWORD_SECRET=change_me_reset_secret
JWT_RESET_PASSWORD_EXPIRES_IN=15m
OTP_EXPIRES_IN=5m

# ── Mail (Nodemailer / Gmail SMTP) ───────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME=KingOfService

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── Facebook OAuth ───────────────────────────────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# ── Cloudinary (upload ảnh) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Goong Maps ───────────────────────────────────────────────────────────────
GOONG_MAPS_API_KEY=your_goong_api_key

# ── Mã hoá at-rest tin nhắn ticket (RSA-OAEP wrap AES-256-GCM) ────────────────
# Cần 1 cặp khoá RSA hợp lệ. Sinh nhanh:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Rồi dán nội dung (giữ nguyên xuống dòng, bọc trong dấu ").
TICKET_MSG_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...paste_public_key...
-----END PUBLIC KEY-----"
TICKET_MSG_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...paste_private_key...
-----END PRIVATE KEY-----"

# ── PayPal — Nạp tiền vào ví tasker ──────────────────────────────────────────
# Lấy Client ID / Secret ở https://developer.paypal.com (Apps & Credentials).
PAYPAL_MODE=sandbox                  # sandbox | live
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
# Webhook ID (lấy sau khi tạo webhook). Bỏ trống thì webhook bị bỏ qua,
# vẫn nạp được qua verify-by-API (GET /wallet/tasker/me/topups/:id).
PAYPAL_WEBHOOK_ID=

# ── Nạp tiền: quy đổi & hạn mức (đều có default, có thể bỏ trống) ─────────────
TASKER_TOPUP_VND_PER_USD=25000       # tỷ giá VND / 1 USD (PayPal tính bằng USD)
TASKER_TOPUP_MIN_VND=10000           # số tiền nạp tối thiểu
TASKER_TOPUP_MAX_VND=50000000        # số tiền nạp tối đa
# URL redirect sau thanh toán (bỏ trống sẽ suy ra từ FRONTEND_URL)
TOPUP_RETURN_URL=http://localhost:3020/tasker/wallet/topup/success
TOPUP_CANCEL_URL=http://localhost:3020/tasker/wallet/topup/cancel

# Ghi chú: số dư ví TỐI THIỂU để nhận đơn tiền mặt (mặc định 50.000đ) KHÔNG ở đây —
# nó nằm trong DB bảng system_configs (key TASKER_MIN_WALLET_BALANCE), sửa qua SQL/admin.
